pkgname=("sysdvr")
pkgdesc="atomspheer for Nintendo Switch"
pkgver=fw%2D23.0.1
pkgrel=1
github=exelix11/dvr-patches
source=(
    "dvr-patches.zip::https://github.com/${github}/releases/download/${pkgver}/dvr-patches.zip"
)
arch=("any")

package() {
    pushd ${srcdir}
      find -type f -exec install -Dm 755 "{}" "${pkgdir}/{}" \;
    popd
}
